__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Runtime artifacts are rebuildable from data/golden/ + data/background/ — never commit them.
data/runtime/*
!data/runtime/.gitkeep

# SQLite is a generated runtime artifact; YAML remains the source of truth.
storage/*.db
storage/*.db-*

# Per-developer Claude Code permission grants — machine-specific, churns every
# session. A shared .claude/settings.json would still be tracked.
.claude/settings.local.json
